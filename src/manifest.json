{
  "manifest_version": 3,
  "name": "Heron: Website Change Monitor",
  "short_name": "Heron",
  "version": "0.1.1",
  "description": "Watch a web page, or one part of it, and get told when it changes. Every check runs in your browser: no account, no server. Free, no ads, no tracking.",
  "browser_specific_settings": {
    "gecko": {
      "id": "heron-website-change-monitor@c4rcer",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["alarms", "storage", "activeTab", "scripting"],
  "optional_permissions": ["notifications"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Heron: watch this page for changes",
    "default_area": "navbar",
    "default_icon": { "48": "icons/icon.svg", "96": "icons/icon.svg" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "options_ui": { "page": "app/app.html", "open_in_tab": true },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" }
}
